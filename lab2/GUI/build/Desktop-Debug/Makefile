####### Compile

error.o: ../../../Error/error.cpp ../../../Error/error.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o error.o ../../../Error/error.cpp

File.o: ../../../File/File.cpp ../../../File/File.h \
		../../../Error/error.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o File.o ../../../File/File.cpp

Gragh.o: ../../../Gragh/Gragh.cpp ../../../Gragh/Gragh.h \
		../../../Gragh/scanner.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o Gragh.o ../../../Gragh/Gragh.cpp

scanner.o: ../../../Gragh/scanner.cpp ../../../Gragh/scanner.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o scanner.o ../../../Gragh/scanner.cpp

main.o: ../../main.cpp ../../../Gragh/scanner.h \
		../../../Gragh/Gragh.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../../main.cpp

qrc_qmake_qmake_qm_files.o: qrc_qmake_qmake_qm_files.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o qrc_qmake_qmake_qm_files.o qrc_qmake_qmake_qm_files.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/GUI/bin || mkdir -p $(INSTALL_ROOT)/opt/GUI/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/GUI/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/GUI/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/GUI/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

