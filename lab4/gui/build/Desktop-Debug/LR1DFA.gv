digraph DFA {
    rankdir=TB;
    node [shape=box, style=filled,          fillcolor=white, fontname="Arial", fontsize=12];
    state0 [label="S0\nS' -> .S   {$}\nS -> .R   {$}\nS -> .L = R   {$}\nL -> .id   {$, =}\nL -> .* R   {$, =}\nR -> .L   {$, =}\n"];
