_if = if
_then = then
_else = else
_while = while
_do = do
_return = return
_void = void
_int = int
_float = float
_double = double
_add = \+
_minus = -
_oneLine_comment_open = \/\/
_open_comment = \/\*
_close_comment = \*\/
_multiply = \*
_divide = \/
_mod = \%
_power = \^
_less_equal = <=
_less = <
_greater_equal = >=
_greater = >
_equal = ==
_not_equal = !=
_assign = =
_semicolon = ;
_comma = ,
_left_paren = \(
_right_paren = \)
_left_bracket = \[
_right_bracket = \]
