digraph DFA {
    rankdir=LR;
    state0 [label="S0\nS' -> .S \nS -> .A + S \nS -> .A \n"];
    state1 [label="S1\nS -> A .+ S \nS -> A .\n"];
    state2 [label="S2\nS' -> S .\n\n规约操作 :\n用文法： S' -> S 规约\n"];
    state3 [label="S3\nS -> A + .S \nS -> .A + S \nS -> .A \n"];
    state4 [label="S4\nS -> A + S .\n\n规约操作 :\n用文法： S -> A + S 规约\n"];
    state3 -> state4 [label="S"];
    state3 -> state1 [label="A"];
    state1 -> state3 [label="+"];
    state0 -> state2 [label="S"];
    state0 -> state1 [label="A"];
}
