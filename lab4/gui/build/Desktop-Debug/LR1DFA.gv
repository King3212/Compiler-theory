    state11 [label="S11\nL -> * R .  {$}\n\n规约操作 :\n用文法： L -> * R 规约\n"];
    state12 [label="S12\nR -> L .  {$, =}\n\n规约操作 :\n用文法： R -> L 规约\n"];
    state13 [label="S13\nL -> * R .  {$, =}\n\n规约操作 :\n用文法： L -> * R 规约\n"];
    state1 -> state2 [label="id"];
    state1 -> state1 [label="*"];
    state7 -> state11 [label="R"];
