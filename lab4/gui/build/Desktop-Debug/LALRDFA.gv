digraph DFA {
    rankdir=TB;
    node [shape=box, style=filled,          fillcolor=white, fontname="Arial", fontsize=12];
    state0 [label="S0\nL -> * R .  {$}\nL -> * R .  {$, =}\n\n规约操作 :\n用文法： L -> * R 规约\n"];
    state1 [label="S1\nS -> L = R .  {$}\n\n规约操作 :\n用文法： S -> L = R 规约\n"];
    state2 [label="S2\nR -> L .  {$}\nR -> L .  {$, =}\n\n规约操作 :\n用文法： R -> L 规约\n"];
    state3 [label="S3\nS' -> S .  {$}\n\n规约操作 :\n用文法： S' -> S 规约\n"];
    state4 [label="S4\nS -> R .  {$}\n\n规约操作 :\n用文法： S -> R 规约\n"];
    state5 [label="S5\nS -> L .= R   {$}\nR -> L .  {$, =}\n\n规约操作 :\n"];
    state6 [label="S6\nS -> L = .R   {$}\nR -> .L   {$}\nL -> .id   {$}\nL -> .* R   {$}\n"];
    state7 [label="S7\nL -> id .  {$, =}\nL -> id .  {$}\n\n规约操作 :\n用文法： L -> id 规约\n"];
    state8 [label="S8\nL -> * .R   {$, =}\nR -> .L   {$, =}\nL -> .id   {$, =}\nL -> .* R   {$, =}\nL -> * .R   {$}\nR -> .L   {$}\nL -> .id   {$}\nL -> .* R   {$}\n"];
    state9 [label="S9\nS' -> .S   {$}\nS -> .R   {$}\nS -> .L = R   {$}\nL -> .id   {$, =}\nL -> .* R   {$, =}\nR -> .L   {$, =}\n"];
    state9 -> state7 [label="id"];
    state9 -> state5 [label="L"];
    state9 -> state4 [label="R"];
    state9 -> state3 [label="S"];
    state8 -> state7 [label="id"];
    state9 -> state8 [label="*"];
    state5 -> state6 [label="="];
    state6 -> state8 [label="*"];
    state8 -> state0 [label="R"];
    state6 -> state2 [label="L"];
    state8 -> state8 [label="*"];
    state6 -> state1 [label="R"];
    state6 -> state7 [label="id"];
    state8 -> state2 [label="L"];
}
