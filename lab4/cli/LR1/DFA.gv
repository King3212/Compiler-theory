digraph DFA {
    rankdir=TB;
    node [shape=box, style=filled,          fillcolor=white, fontname="Arial", fontsize=12];
    state0 [label="S0\nS' -> .S \nS -> .A + S \nS -> .A \nA -> .number * A \nA -> .number \n"];
    state1 [label="S1\nA -> number .* A \nA -> number .\n\n规约操作 :\n用文法： A -> number 规约\n"];
    state2 [label="S2\nS -> A .+ S \nS -> A .\n\n规约操作 :\n用文法： S -> A 规约\n"];
    state3 [label="S3\nS' -> S .\n\n规约操作 :\n用文法： S' -> S 规约\n"];
    state4 [label="S4\nS -> A + .S \nS -> .A + S \nS -> .A \nA -> .number * A \nA -> .number \n"];
    state5 [label="S5\nS -> A + S .\n\n规约操作 :\n用文法： S -> A + S 规约\n"];
    state6 [label="S6\nA -> number * .A \nA -> .number * A \nA -> .number \n"];
    state7 [label="S7\nA -> number * A .\n\n规约操作 :\n用文法： A -> number * A 规约\n"];
    state0 -> state1 [label="number"];
    state0 -> state2 [label="A"];
    state2 -> state4 [label="+"];
    state6 -> state7 [label="A"];
    state0 -> state3 [label="S"];
    state4 -> state2 [label="A"];
    state4 -> state1 [label="number"];
    state4 -> state5 [label="S"];
    state1 -> state6 [label="*"];
    state6 -> state1 [label="number"];
}
